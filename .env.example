# Copie para .env.local (nunca commite chaves reais).

# Provider de dados:
#   "uefa"         temporada real em andamento, dados do site da UEFA (grátis, sem chave);
#   "api-football" API-Football (chave; plano grátis só acessa 2022–2024);
#   "mock"         temporada simulada para desenvolvimento.
DATA_PROVIDER=mock

# UEFA — temporada pelo ano em que termina (2026/27 = 2027). Champions League = 1.
UEFA_SEASON_YEAR=2027
UEFA_COMPETITION_ID=1
# Intervalo mínimo entre requisições (ms), para não sobrecarregar o site.
UEFA_MIN_INTERVAL_MS=400
# Sincronização automática dentro do servidor (minutos). Padrão: 15 com DATA_PROVIDER=uefa; 0 desliga.
# AUTO_SYNC_MINUTES=15

# API-Football (https://dashboard.api-football.com) — obrigatória quando DATA_PROVIDER=api-football.
API_FOOTBALL_KEY=
# Temporada 2026/27 = 2026. Champions League = liga 2.
# Plano grátis só acessa 2022–2024: use 2024 com API_FOOTBALL_REPLAY=true para testar com dados reais.
API_FOOTBALL_SEASON=2026
API_FOOTBALL_LEAGUE_ID=2
# Intervalo mínimo entre requisições (ms). Plano grátis: 10/min → 6500.
API_FOOTBALL_MIN_INTERVAL_MS=6500
# Plano grátis não aceita o parâmetro `ids`: false = 1 partida por requisição.
API_FOOTBALL_BATCH_IDS=true
# true = reapresenta uma temporada encerrada como se estivesse acontecendo agora (relógio de replay).
API_FOOTBALL_REPLAY=false

# Banco: vazio = PGlite embutido (./.data/pglite no mock, ./.data/pglite-api na API-Football, ./.data/pglite-uefa na UEFA).
DATABASE_URL=

# Segredo para as rotas de job agendado (/api/cron). Use um valor aleatório longo.
CRON_SECRET=

# Só para testes locais: segundos por pick no draft (padrão 60).
# DRAFT_PICK_SECONDS=
